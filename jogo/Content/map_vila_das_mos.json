  "npcs": [
    {
      "id": "moleira_benta",
      "name": "Benta, a Moleira",
      "role": "missoes",
      "x": 11.5,
      "y": 12.3,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«O moinho não para nem domingo! Se você tem braço, eu tenho serviço — e pão quentinho de pagamento.»"
    },
    {
      "id": "estalajadeiro_otaviano",
      "name": "Otaviano, o Estalajadeiro",
      "role": "missoes",
      "x": 15.0,
      "y": -11.2,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Quarto? Tem. Cama? Tem. Silêncio? Só depois que os viajantes do Vale param de contar história.»"
    },
    {
      "id": "mascate_quirino",
      "name": "Quirino, o Mascate de Mapas",
      "role": "loja",
      "x": 3.5,
      "y": -4.5,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Mapa do tesouro, freguês! Uns são verdadeiros. Os outros… também, de certo jeito.»",
      "shop": "loja_vila_mapas"
    },
    {
      "id": "erveira_celeste",
      "name": "Celeste, a Erveira",
      "role": "curandeira",
      "x": -9,
      "y": -3.5,
      "facing": 0,
      "look": "curandeira",
      "greeting": "«Chá de erva-tônica pra quem vai ao Vale. E pra quem volta, um abraço.»",
      "shop": "loja_curandeira"
    },
    {
      "id": "ferreiro_ze",
      "name": "Zé Ferradura, o Ferreiro",
      "role": "ferreiro",
      "x": 21,
      "y": -9,
      "facing": 270,
      "look": "ferreiro",
      "greeting": "«Ferradura, foice, faca… e espada também, se você insistir.»",
      "shop": "loja_ferreiro"
    },
    {
      "id": "menino_tiquinho",
      "name": "Tiquinho",
      "role": "morador",
      "x": -3,
      "y": 13,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«Quando o vento para, o moinho chora. A Benta diz que é a pedra rangendo. Eu acho que é fantasma.»"
    },
    {
      "id": "guarda_fiel",
      "name": "Fiel, o Guarda da Estrada",
      "role": "morador",
      "x": -27,
      "y": 3,
      "facing": 90,
      "look": "guarda",
      "greeting": "«Daqui pra oeste é a Costa do Cal. Pra leste, o Vale das Cinzas. Eu fico aqui no meio, que é mais seguro.»"
    }
  ],
  "objects": [
    {
      "id": "vila_das_mos_porta_0",
      "kind": "porta",
      "x": 15.0,
      "y": -13.15,
      "label": "Estalagem do Moinho",
      "text": "Cheiro de pão quente e cerveja de cevada. «Entra, que a sopa é de graça pra quem traz notícia!»"
    },
    {
      "id": "vila_das_mos_porta_1",
