  "npcs": [
    {
      "id": "mestra_bruna",
      "name": "Bruna Martelo-Frio, a Mestra da Forja",
      "role": "loja",
      "x": 0.5,
      "y": 9.5,
      "facing": 180,
      "look": "ferreiro",
      "greeting": "«Armadura de gente grande se forja aqui. Lá fora você arranca dos monstros; aqui você compra pronta — se tiver ouro.»",
      "shop": "loja_brasaforte_forja"
    },
    {
      "id": "vigia_hrolf",
      "name": "Velho Hrolf, o Vigia",
      "role": "missoes",
      "x": -14.0,
      "y": 11.9,
      "facing": 180,
      "look": "guarda",
      "greeting": "«Sessenta invernos de vigia. Os lobos de gelo pela frente, o fogo da Escória pelas costas. E agora você. Serve?»"
    },
    {
      "id": "peleiro_torvi",
      "name": "Torvi, o Peleiro",
      "role": "curandeira",
      "x": 15.5,
      "y": -6.5,
      "facing": 270,
      "look": "aldeao",
      "greeting": "«Tônico forte e casaco de pele. O frio daqui mata mais que draugr.»",
      "shop": "loja_curandeira"
    },
    {
      "id": "taverneira_sigrun",
      "name": "Sigrun, a Taverneira",
      "role": "missoes",
      "x": 17.0,
      "y": 13.7,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«Cerveja quente, sopa de raiz e briga só lá fora. Quer trabalho? O Hrolf tem. Quer fofoca? Eu tenho.»"
    },
    {
      "id": "mineiro_durval",
      "name": "Durval Barba-de-Brasa, o Mineiro",
      "role": "morador",
      "x": -10,
      "y": -4,
      "facing": 90,
      "look": "aldeao",
      "greeting": "«Cavamos até achar o fogo. Achamos. Agora a cidade é quente embaixo e fria em cima.»"
    },
    {
      "id": "guarda_portao_brasa",
      "name": "Guarda do Portão",
      "role": "morador",
      "x": 4,
      "y": -22,
      "facing": 180,
      "look": "guarda",
      "greeting": "«Ao sul, a Coroa da Geada. Ao norte, o Mar de Escória. Brasaforte segura os dois.»"
    }
  ],
