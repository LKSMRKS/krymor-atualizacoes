  "npcs": [
    {
      "id": "lanterneira_ilda",
      "name": "Ilda, a Lanterneira",
      "role": "missoes",
      "x": -13,
      "y": 10.5,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«Lanterna acesa espanta afogado. Lanterna apagada chama. Por isso aqui ninguém dorme no escuro.»"
    },
    {
      "id": "vigia_teodoro",
      "name": "Teodoro, o Vigia da Véspera",
      "role": "missoes",
      "x": 25,
      "y": 2.5,
      "facing": 270,
      "look": "guarda",
      "greeting": "«Do lado de lá o sol não se põe nem nasce. Fica parado, vermelho, olhando. E as coisas que andam lá não gostam de luz.»"
    },
    {
      "id": "boticario_anselmo",
      "name": "Anselmo, o Boticário",
      "role": "loja",
      "x": 4,
      "y": -3.5,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Água benta, antídoto de sapo e panaceia. Quem vai à Véspera leva os três. Quem volta, compra de novo.»",
      "shop": "loja_candeia_boticario"
    },
    {
      "id": "curandeira_marta",
      "name": "Marta, a Rezadeira",
      "role": "curandeira",
      "x": -9,
      "y": -3.5,
      "facing": 0,
      "look": "curandeira",
      "greeting": "«Tônico e reza. O tônico fecha a ferida; a reza é pra você não ficar com medo de voltar.»",
      "shop": "loja_curandeira"
    },
    {
      "id": "ferreiro_brunilda",
      "name": "Brunilda, a Ferreira",
      "role": "ferreiro",
      "x": 21,
      "y": -9,
      "facing": 270,
      "look": "ferreiro",
      "greeting": "«Prata no fio da lâmina. Vampiro não gosta. Eu também não gosto de vampiro.»",
      "shop": "loja_ferreiro"
    },
    {
      "id": "taverneiro_lume",
      "name": "Lume, da Última Luz",
      "role": "morador",
      "x": 16.0,
      "y": -11.2,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Sopa de raiz do brejo e vinho da Véspera. O vinho é por sua conta — e por seu risco.»"
    },
    {
      "id": "menina_faisca",
      "name": "Faísca",
      "role": "morador",
      "x": 3,
      "y": 12,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«Eu conto lanternas. Ontem eram 412. Hoje 411. Alguém levou uma pra Véspera e não voltou.»"
    }
  ],
  "objects": [
    {
      "id": "candeia_porta_0",
      "kind": "porta",
      "x": 16.0,
      "y": -13.15,
      "label": "Estalagem da Última Luz",
      "text": "Cada mesa tem uma lanterna acesa. «Aqui ninguém apaga a luz. Nunca. Nem pra dormir.»"
    },
    {
      "id": "candeia_porta_1",
      "kind": "porta",
