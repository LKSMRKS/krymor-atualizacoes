  "npcs": [
    {
      "id": "astronoma_dalia",
      "name": "Dália, a Astrônoma-Chefe",
      "role": "missoes",
      "x": 14,
      "y": 12.5,
      "facing": 180,
      "look": "arcanista",
      "greeting": "«Os mapas do céu não fecham. Faltam quatro estrelas — e a lua anda um palmo fora do lugar. Alguém mexeu no céu.»"
    },
    {
      "id": "alfaiate_lorena",
      "name": "Lorena, a Alfaiate das Estrelas",
      "role": "loja",
      "x": -20,
      "y": -11.5,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Mantos, capuzes e elmos que não se acham em lugar nenhum. Feitos aqui, com linha de estrela.»",
      "shop": "loja_astralia_alfaiate"
    },
    {
      "id": "irma_vesper",
      "name": "Irmã Vésper, a Boticária",
      "role": "curandeira",
      "x": 9,
      "y": -3.5,
      "facing": 0,
      "look": "curandeira",
      "greeting": "«Tônicos destilados à luz da lua. Funcionam igual aos outros, só são mais bonitos.»",
      "shop": "loja_curandeira"
    },
    {
      "id": "escriba_tobias",
      "name": "Tobias, o Escriba",
      "role": "missoes",
      "x": -14,
      "y": 11.5,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«Copio os mapas do céu desde menino. Os antigos têm quatro reinos desenhados nas bordas. Os novos, não. Curioso, né?»"
    },
    {
      "id": "capitao_orion",
      "name": "Capitão Órion, da Guarda",
      "role": "morador",
      "x": -29,
      "y": 3,
      "facing": 90,
      "look": "guarda",
      "greeting": "«A oeste, a Mata dos Enforcados. A leste, os Cânions. Astrália fica no meio e olha pro céu, que é mais bonito.»"
    },
    {
      "id": "menina_estela",
      "name": "Estela",
      "role": "morador",
      "x": 5,
      "y": 1.5,
      "facing": 180,
      "look": "aldeao",
      "greeting": "«O Merlin me deixou olhar pela luneta grande! Vi um castelo de cabeça para baixo na lua. Ninguém acredita.»"
    },
    {
      "id": "taverneiro_cometa",
      "name": "Bóris, do Cometa",
      "role": "morador",
      "x": 17.0,
      "y": -11.2,
      "facing": 0,
      "look": "aldeao",
      "greeting": "«Hidromel de cometa: uma caneca e você vê estrelas. Duas, e você vira uma.»"
    },
    {
      "id": "merlin_mago",
      "name": "Merlin, o Mago das Estrelas",
      "role": "missoes",
      "x": 3.2,
      "y": 12.68,
